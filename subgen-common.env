#
# Whisper model
#
WHISPER_MODEL="large-v2"
#WHISPER_MODEL="large-v3"

#
# Audio
#
PREFERRED_AUDIO_LANGUAGES="eng|spa|fre|mac"
DETECT_LANGUAGE_OFFSET="120"
FORCE_DETECTED_LANGUAGE_TO=""
SHOULD_WHISPER_DETECT_AUDIO_LANGUAGE="True"

#
# Subtitles
#
SUBTITLES_LANGUAGE_NAME="aa"
SKIP_IF_INTERNAL_SUBTITLES_LANGUAGE=""
SKIP_IF_EXTERNAL_SUBTITLES_EXIST="aa"
SUBTITLE_LANGUAGE_NAMING_TYPE="ISO_639_1"
SKIP_IF_TARGET_SUBTITLES_EXIST="False"
SKIP_ONLY_SUBGEN_SUBTITLES="False"

#
# Transcription
#
CONCURRENT_TRANSCRIPTIONS="1"
WORD_LEVEL_HIGHLIGHT="False"
APPEND="False"

#
# Path
#
USE_PATH_MAPPING="True"
PATH_MAPPING_FROM="/mnt/media"
PATH_MAPPING_TO=""
MODEL_PATH="./models"

#
# Filename
#
SHOW_IN_SUBNAME_SUBGEN="True"
SHOW_IN_SUBNAME_MODEL="True"

#
# Debug
#
# Ollama translator: If set to True, show every original/translated lines on STDOUT as they are processed.
#
DEBUG="False"

#
# Model options
#
USE_MODEL_PROMPT="False"
CUSTOM_MODEL_PROMPT=""
LRC_FOR_AUDIO_FILES="True"
CUSTOM_REGROUP="cm_sl=84_sl=42++++++1"

#
# GPU
#
CLEAR_VRAM_ON_COMPLETE="True"

#
# Monitor
#
TRANSCRIBE_FOLDERS=""
MONITOR="False"

#
# Webhooks
#
PROCESS_ADDED_MEDIA="False"
PROCESS_MEDIA_ON_PLAY="True"

#
# Jellyfin
#
# JELLY_* vars are defined in ".env" file
#
JELLYFIN_TOKEN="${JELLY_TOKEN}"
JELLYFIN_SERVER="${JELLY_SERVER}"
WEBHOOK_PORT="${JELLY_WEBHOOK_PORT}"

#
# Update
#
# If set to "True", should auto-update .py files from original project, thus overriding code from this fork.
#
UPDATE="False"

#
# Time
#
# The TZ variable is used in the Dockerfile during build operation.
#
TZ="Europe/Brussels"

