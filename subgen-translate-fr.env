#
# Built-in Whisper LLM
#
# Transcription in source audio language.
#
TRANSCRIBE_OR_TRANSLATE="transcribe"

#
# External Ollama instance
#
# Translation in French.
#
# Enable external translation.
OLLAMA_TRANSLATE="True"

#
# Ollama API url.
# OLLAMA_SVC variable is defined in the ".env" file.
OLLAMA_TRANSLATE_API_URL="http://${OLLAMA_SVC}/api"

#
# Language of the source subtitle to translate.
# "auto" for auto-detection.
# Example: "en", "es", "auto".
OLLAMA_TRANSLATE_SRC="auto"

#
# Languages to translate to.
# Can be a pipe-separated list.
# Example: "fr|mk".
OLLAMA_TRANSLATE_TGT="fr"

#
# Ollama model to use for translation.
# Can be a pipe-separated list.
OLLAMA_TRANSLATE_MODEL="zongwei/gemma3-translator:4b"

